# Winnersbookmark AgentOS — copy to .env.local and fill in. See docs/ENVIRONMENT.md.
# Never prefix any of these with NEXT_PUBLIC_.

# --- Required -----------------------------------------------------------------
# printf '%s' 'your long password' | npm run --silent hash-password
AGENTOS_OWNER_PASSWORD_HASH=
# openssl rand -hex 32
AGENTOS_SESSION_SECRET=
# Supabase pooled connection string (no sslmode parameter). Empty = in-memory dev store.
DATABASE_URL=
# Supabase CA certificate PEM (Database Settings → SSL). Not needed for localhost.
DATABASE_CA_CERT=

# --- Roxy · OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# --- Zeus · Meta Muse (Meta Model API) ------------------------------------------
META_MODEL_API_KEY=
# META_MODEL=muse-spark-1.3        (-contributor models are refused)

# --- Hermes · Hermes Agent API server -------------------------------------------
# Server root on infrastructure you control; key = Hermes API_SERVER_KEY.
HERMES_BASE_URL=
HERMES_API_KEY=
# HERMES_MODEL=hermes-agent

# --- Gemini · Google Gemini API --------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Controls -------------------------------------------------------------------
# AGENTOS_ALLOW_MOCK=false
# AGENTOS_MAX_RUNS_PER_HOUR=30
# AGENTOS_MAX_OUTPUT_TOKENS=8000
