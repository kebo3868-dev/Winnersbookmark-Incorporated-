generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum AuditStage {
  INITIALIZING
  VALIDATING_WEBSITE
  DISCOVERING_PAGES
  COLLECTING_EVIDENCE
  ANALYZING_CUSTOMER_JOURNEY
  DETECTING_REVENUE_LEAKS
  SCORING_OPPORTUNITIES
  CALCULATING_RESCUE_SCORE
  GENERATING_OWNER_REPORT
  GENERATING_SALES_BRIEF
  COMPLETED
  FAILED
}

enum SourceStatus {
  COLLECTED
  UNAVAILABLE
  BLOCKED
  TIMEOUT
  ERROR
}

enum ReportType {
  OWNER_AUDIT
  INTERNAL_SALES
}

enum SalesPriority {
  HOT
  WARM
  NURTURE
  LOW_PRIORITY
}

model Restaurant {
  id         String      @id @default(cuid())
  name       String
  websiteUrl String
  city       String?
  state      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  audits     Audit[]
  auditLeads AuditLead[]

  @@unique([websiteUrl])
}

model Audit {
  id              String      @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id])
  status          AuditStatus @default(PENDING)
  demoMode        Boolean     @default(false)
  aiEnabled       Boolean     @default(false)
  knownConcern    String?
  overallScore    Int?
  coverageScore   Int?
  confidenceLevel String?
  startedAt       DateTime?
  completedAt     DateTime?
  failureReason   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Phase 3 — optional owner-supplied intake. Pathway hints are probed like
  // any discovered link; review data is owner-reported (never scraped) and
  // feeds the REVIEW journey stage + reputation score when present.
  reservationUrlInput String?
  orderingUrlInput    String?
  socialUrlInput      String?
  googleBusinessUrl   String?
  ownerRating         Float?
  ownerReviewCount    Int?
  avgTicketInput      Float?

  sources           AuditSource[]
  evidence          Evidence[]
  opportunities     Opportunity[]
  scores            AuditScore[]
  reports           Report[]
  salesIntelligence SalesIntelligence?
  job               AuditJob?
  journeyStages     JourneyStage[]
  lead              AuditLead?
}

// Phase 3 lead capture. Named AuditLead / AuditLeadStatus (not Lead /
// LeadStatus) because this production database is shared with a separate
// "voice rescue" application that already owns a `Lead` table and a
// `LeadStatus` enum with different columns/values. Unique names keep the two
// systems from colliding in the shared `public` schema.
enum AuditLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model AuditLead {
  id           String          @id @default(cuid())
  auditId      String          @unique
  audit        Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  contactName  String?
  email        String?
  phone        String?
  consent      Boolean         @default(false)
  status       AuditLeadStatus @default(NEW)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model AuditSource {
  id          String       @id @default(cuid())
  auditId     String
  audit       Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url         String
  pageTitle   String?
  sourceType  String
  status      SourceStatus
  httpStatus  Int?
  note        String?
  collectedAt DateTime?
  createdAt   DateTime     @default(now())
  evidence    Evidence[]
}

model Evidence {
  id                String       @id @default(cuid())
  auditId           String
  audit             Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditSourceId     String?
  auditSource       AuditSource? @relation(fields: [auditSourceId], references: [id])
  evidenceType      String
  fact              String
  supportingContext String?
  confidence        Int
  createdAt         DateTime     @default(now())
}

model JourneyStage {
  id                       String   @id @default(cuid())
  auditId                  String
  audit                    Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  stage                    String
  status                   String
  finding                  String
  confidence               Int
  manualValidationRequired Boolean  @default(false)
  evidenceIds              String[]
}

model Opportunity {
  id                       String   @id @default(cuid())
  auditId                  String
  audit                    Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category                 String
  title                    String
  problem                  String
  businessImpact           String
  customerJourneyStage     String
  evidenceIds              String[]
  impactScore              Int
  urgencyScore             Int
  confidenceScore          Int
  aiFitScore               Int
  rescuePriorityScore      Int
  recommendedSolution      String
  manualValidationRequired Boolean  @default(false)
  createdAt                DateTime @default(now())
}

model AuditScore {
  id               String  @id @default(cuid())
  auditId          String
  audit            Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category         String
  weight           Int
  score            Int?
  confidence       Int
  insufficientData Boolean @default(false)
  explanation      String
}

model Report {
  id         String     @id @default(cuid())
  auditId    String
  audit      Audit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  reportType ReportType
  content    Json
  createdAt  DateTime   @default(now())

  @@unique([auditId, reportType])
}

model SalesIntelligence {
  id                    String        @id @default(cuid())
  auditId               String        @unique
  audit                 Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  leadQualityScore      Int
  salesOpportunityScore Int
  painLevel             String
  buyerPersona          String
  bestSalesAngle        String
  topDiscoveryQuestion  String
  discoveryQuestions    String[]
  likelyObjection       String
  objectionStrategy     String
  recommendedOffer      String
  outreachAngle         String
  emailOpener           String
  callOpener            String
  talkTrack             String
  followUpAngle         String
  priority              SalesPriority
  createdAt             DateTime      @default(now())
}

model AuditJob {
  id           String      @id @default(cuid())
  auditId      String      @unique
  audit        Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  status       AuditStatus @default(PENDING)
  currentStage AuditStage  @default(INITIALIZING)
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  auditId   String?
  level     String
  message   String
  detail    String?
  createdAt DateTime @default(now())
}

// ============================================================================
// WINNERS BOOKMARK AI FRONT DESK
// ============================================================================
//
// A separate product from the Restaurant Rescue Audit above, sharing this
// application's database, Prisma client and deployment. Every model is
// prefixed `Fd` for two reasons: this database is shared with other Winners
// Bookmark applications (see the AuditLead comment above), and the prefix
// makes it obvious at a glance which product a table belongs to.
//
// MULTI-TENANT RULE (§XIX): every row that can contain restaurant or customer
// data carries `tenantId`, and every index leads with it. Queries are written
// tenant-first so a missing filter is a compile-time or index-visible mistake
// rather than a silent cross-tenant leak.

enum FdTenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum FdChannel {
  WEB
  SMS
  VOICE
}

enum FdMessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
}

enum FdLeadCategory {
  RESERVATION
  LARGE_PARTY
  CATERING
  PRIVATE_EVENT
  TAKEOUT
  DELIVERY
  GENERAL
  COMPLAINT_RECOVERY
}

enum FdLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  WON
  LOST
  CLOSED
  ESCALATED
}

enum FdPriority {
  STANDARD
  HIGH
  URGENT
}

enum FdEscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// One restaurant client. `config` holds the validated TenantConfig (Layer 2);
/// the engine reads nothing about a restaurant from anywhere else.
model FdTenant {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  status            FdTenantStatus @default(ONBOARDING)
  demoMode          Boolean        @default(false)
  /// SHA-256 of this restaurant's own inbound-webhook secret. Per tenant so a
  /// leaked secret cannot be used to forge events for a different restaurant.
  /// NULL means this tenant has no inbound webhook configured yet.
  webhookSecretHash String?

  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations        FdConversation[]
  messages             FdMessage[]
  leads                FdLead[]
  escalations          FdEscalation[]
  apiKeys              FdApiKey[]
  auditLogs            FdAuditLog[]
  notifications        FdNotification[]
  failures             FdFailure[]
  consents             FdConsent[]
  inboundEvents        FdInboundEvent[]
  rateCounters         FdRateCounter[]
  contactVerifications FdContactVerification[]
  users                FdUser[]
  bookingAttempts      FdBookingAttempt[]
  reviewRequests       FdReviewRequest[]

  @@index([status])
}

model FdConversation {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        FdTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       FdChannel @default(WEB)
  /// Provider-side identifier (call SID, thread id) for de-duplicating webhooks.
  externalRef   String?
  customerName  String?
  customerPhone String?
  escalated     Boolean   @default(false)
  demoMode      Boolean   @default(false)
  startedAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())

  messages       FdMessage[]
  reviewRequests FdReviewRequest[]
  leads          FdLead[]
  escalations    FdEscalation[]

  @@unique([tenantId, channel, externalRef])
  @@index([tenantId, startedAt])
}

model FdMessage {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         FdTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   FdConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           FdMessageRole
  body           String
  /// Detected intent, and which verified source the reply came from. Together
  /// these are the anti-hallucination audit trail an operator can review.
  intent         String?
  answerSource   String?
  createdAt      DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId, createdAt])
}

model FdLead {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              FdTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId      String?
  conversation        FdConversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  source              String
  customerName        String?
  phone               String?
  email               String?
  category            FdLeadCategory
  intent              String
  priority            FdPriority         @default(STANDARD)
  partySize           Int?
  requestedDate       String?
  requestedTime       String?
  notes               String?
  /// ESTIMATED opportunity value only. Never rendered as confirmed revenue.
  estimatedValueCents Int?
  status              FdLeadStatus       @default(NEW)
  assignedTo          String?
  lastContactAt       DateTime?
  followUpDueAt       DateTime?
  resolution          String?
  demoMode            Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  bookingAttempts     FdBookingAttempt[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, category])
}

model FdEscalation {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         FdTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   FdConversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reason         String
  severity       String
  summary        String
  customerName   String?
  contact        String?
  /// Config key of the escalation contact this routed to (never the contact
  /// details themselves — those live in config and can change).
  routeTo        String
  notifications  FdNotification[]
  status         FdEscalationStatus @default(OPEN)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  demoMode       Boolean            @default(false)
  createdAt      DateTime           @default(now())

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// PHASE 2 — per-tenant authentication and auditing
// ---------------------------------------------------------------------------

/// A credential belonging to exactly one restaurant. Only the SHA-256 digest is
/// stored; the plaintext is shown once at creation and is unrecoverable after.
model FdApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     FdTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Operator-facing label, e.g. "website widget".
  name       String
  /// Non-secret leading fragment, so two keys can be told apart in the UI.
  prefix     String
  /// SHA-256 of the plaintext. Unique so a lookup is a single indexed read.
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@index([tenantId, revokedAt])
}

/// Append-only record of security-relevant events (§XX, §XXIV).
/// Never contains a credential, a key digest, or customer message content.
model FdAuditLog {
  id        String    @id @default(cuid())
  /// Null when the event could not be attributed to a tenant (e.g. unknown key).
  tenantId  String?
  tenant    FdTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  event     String
  actor     String
  /// FdApiKey id when the actor was a tenant key.
  keyId     String?
  outcome   String
  detail    String?
  /// Request correlation id, for tracing across logs.
  requestId String?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([event, createdAt])
}

// ---------------------------------------------------------------------------
// PHASE 2 — outbound notifications and the operator failure queue
// ---------------------------------------------------------------------------

enum FdNotificationStatus {
  /// Waiting for its first send, or for a scheduled retry.
  QUEUED
  /// Claimed by a worker and in flight. A row stuck here past the lease
  /// timeout is reclaimed — that is how a crashed worker is recovered.
  SENDING
  /// Handed to the provider; not yet confirmed on a handset.
  SENT
  /// Provider confirmed delivery.
  DELIVERED
  /// Provider confirmed it could not deliver.
  UNDELIVERED
  /// Retries exhausted, or a permanent error. Terminal, and operator-visible.
  ABANDONED
}

enum FdFailureCategory {
  FAILED_SMS
  FAILED_NOTIFICATION
  FAILED_INTEGRATION
  FAILED_BOOKING
  FAILED_DATA_WRITE
  FAILED_WEBHOOK
  FAILED_AI_RESPONSE
}

enum FdFailureStatus {
  OPEN
  RETRYING
  RESOLVED
  ABANDONED
}

/// Lifecycle of a test alert sent to an escalation contact.
/// VERIFIED is only ever reached from a provider delivery receipt — never from
/// a send being accepted, which proves nothing about a handset.
enum FdContactVerificationStatus {
  PENDING
  SENT
  VERIFIED
  FAILED
}

/// One outbound message and its full delivery history.
model FdNotification {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            FdTenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  escalationId      String?
  escalation        FdEscalation?        @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  channel           String               @default("SMS")
  purpose           FdMessagePurpose     @default(ESCALATION_ALERT)
  /// Staff destination taken from tenant config — not a customer's number.
  toNumber          String
  fromNumber        String
  body              String
  status            FdNotificationStatus @default(QUEUED)
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(3)
  nextAttemptAt     DateTime?
  /// Worker lease. Set when a row is claimed, cleared when it is finished.
  lockedAt          DateTime?
  lockedBy          String?
  providerName      String?
  providerMessageId String?              @unique
  errorCode         String?
  errorMessage      String?
  /// True when the provider was a mock. Surfaced in the UI so a simulated
  /// send can never be mistaken for a real one.
  simulated         Boolean              @default(false)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([tenantId, createdAt])
}

/// OPERATOR-VISIBLE FAILURE QUEUE (§XVI). Nothing fails silently: every
/// abandoned notification, rejected webhook or integration error lands here.
/// Proof that a specific escalation contact can actually be reached.
///
/// An escalation rota made of numbers nobody has ever texted is a list of
/// assumptions. This records a real test alert and the delivery receipt that
/// came back, so the pilot gate can require evidence rather than intent.
model FdContactVerification {
  id             String                      @id @default(cuid())
  tenantId       String
  tenant         FdTenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Escalation contact key from tenant config, e.g. "manager".
  contactKey     String
  /// The number tested. Stored so a later config edit invalidates the proof.
  phone          String
  /// The test notification whose delivery receipt confirms this.
  notificationId String?
  status         FdContactVerificationStatus @default(PENDING)
  requestedBy    String?
  requestedAt    DateTime                    @default(now())
  verifiedAt     DateTime?
  failureReason  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([tenantId, contactKey, phone])
  @@index([tenantId, status])
  @@index([notificationId])
}

model FdFailure {
  id          String            @id @default(cuid())
  tenantId    String?
  tenant      FdTenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    FdFailureCategory
  /// What was being attempted, e.g. "escalation.notify".
  operation   String
  detail      String
  /// Id of the row this failure concerns (a notification, a lead, a booking).
  referenceId String?
  /// Coalescing key for failures caused by UNAUTHENTICATED requests.
  ///
  /// Rejected requests must stay visible to an operator — a rotated secret has
  /// to surface somewhere — but one row per rejected request lets anyone on the
  /// internet grow this table without limit. Rejections therefore upsert on
  /// this key (scope|operation|reason|hour) and increment `attempts`, so an
  /// attack costs one row per hour instead of one row per request.
  ///
  /// NULL for ordinary failures, which are already bounded by real work.
  dedupeKey   String?           @unique
  attempts    Int               @default(0)
  status      FdFailureStatus   @default(OPEN)
  lastError   String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([category, status])
}

// ---------------------------------------------------------------------------
// PHASE 2 M3 — inbound messaging, consent, and rate limiting
// ---------------------------------------------------------------------------

enum FdConsentStatus {
  /// Never heard from this number, and never messaged it.
  UNKNOWN
  /// Reached out to us, or explicitly opted in.
  IMPLIED
  /// Explicitly opted in (START after a STOP, or a form).
  OPTED_IN
  /// Sent STOP/UNSUBSCRIBE. Blocks every outbound message, permanently,
  /// until they explicitly opt back in.
  OPTED_OUT
}

/// What an outbound message is FOR. Consent and rate rules differ: an
/// operational alert to a manager is not the same thing as a marketing-adjacent
/// follow-up to a customer, and they must not be treated identically.
enum FdMessagePurpose {
  /// To restaurant staff, about an escalation.
  ESCALATION_ALERT
  /// To a customer whose call we missed.
  MISSED_CALL_RECOVERY
  /// A front desk reply inside a conversation the customer started.
  CONVERSATION_REPLY
}

/// One consent record per (restaurant, phone number). Consent is per tenant,
/// never global: opting out of one restaurant must not silence another.
model FdConsent {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        FdTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// E.164.
  phone         String
  status        FdConsentStatus @default(UNKNOWN)
  /// How the current status was reached, e.g. "INBOUND_STOP", "INBOUND_MESSAGE".
  source        String?
  optedInAt     DateTime?
  optedOutAt    DateTime?
  lastInboundAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, status])
}

/// DUPLICATE WEBHOOK PROTECTION. Providers redeliver aggressively; without
/// this, one inbound SMS could be answered several times and one missed call
/// could trigger several recovery messages.
model FdInboundEvent {
  id              String   @id @default(cuid())
  /// Required. An event is always resolved to a tenant before it is claimed.
  tenantId        String
  tenant          FdTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String
  /// The provider's own id for this event.
  providerEventId String
  kind            String
  receivedAt      DateTime @default(now())

  /// Scoped by tenant. A global constraint would let one restaurant's event id
  /// collide with another's and silently drop it as a duplicate — a
  /// cross-tenant data-loss path, not just a tidiness issue.
  @@unique([tenantId, provider, providerEventId])
  @@index([tenantId, receivedAt])
}

/// Fixed-window send counters. Deliberately simple and inspectable: an
/// operator can read exactly why a message was throttled.
model FdRateCounter {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      FdTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "TENANT" or "NUMBER".
  scope       String
  /// The tenant id or the E.164 number the window applies to.
  subject     String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([tenantId, scope, subject, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// PHASE 4 M4 — tenant users, roles and sessions
// ---------------------------------------------------------------------------

/// Least-privilege roles (§XXVI). Every role except WBI_ADMIN is bound to
/// exactly one restaurant by the user's tenantId.
enum FdRole {
  /// Winners Bookmark staff. The only role that may act across tenants.
  WBI_ADMIN
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  RESTAURANT_STAFF
  READ_ONLY
}

enum FdUserStatus {
  ACTIVE
  SUSPENDED
}

/// A person who can sign in.
///
/// `tenantId` IS the isolation boundary: it is NULL only for WBI_ADMIN, and
/// non-null for every restaurant user. Authorization compares it against the
/// restaurant being addressed, so a restaurant user physically cannot be
/// resolved to another restaurant's data.
model FdUser {
  id           String       @id @default(cuid())
  /// NULL only for WBI_ADMIN. Enforced in code and asserted by tests.
  tenantId     String?
  tenant       FdTenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  /// scrypt digest, salted per user. Never a plaintext or reversible value.
  passwordHash String
  name         String?
  role         FdRole
  status       FdUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions FdSession[]

  /// Email is unique per tenant, not globally: the same person may hold
  /// accounts at two restaurants without either account implying the other.
  @@unique([tenantId, email])
  @@index([tenantId, status])
}

/// A signed-in session. Only a digest of the token is stored, so a database
/// leak does not hand an attacker usable sessions.
model FdSession {
  id         String    @id @default(cuid())
  userId     String
  user       FdUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token held in the cookie.
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

/// M7a — RESERVATION BOOKING LIFECYCLE (§V, §XXIII)
///
/// One row per booking ATTEMPT, not per booking. The distinction matters: the
/// dangerous moment is a worker dying between "vendor accepted" and "we wrote
/// it down", and only a durable per-attempt record makes that recoverable
/// without seating the party twice.
///
/// `idempotencyKey` is unique. A retry reuses the key, the vendor recognises
/// the repeat, and the row is updated rather than duplicated — the same
/// at-least-once discipline FdNotification uses, with a higher cost of failure:
/// a duplicate SMS is noise, a duplicate booking consumes a real table.
enum FdBookingStatus {
  /// Recorded, not yet sent to a vendor.
  PENDING
  /// Claimed and in flight. A row stuck here past the lease timeout is
  /// reclaimed — that is how a crashed worker is recovered.
  SENDING
  /// The vendor took the request; nobody has a table yet. Maps to a REQUESTED
  /// lead, never BOOKED.
  ACCEPTED_PENDING
  /// The vendor returned a confirmation reference. The ONLY status that
  /// justifies telling a customer they have a booking.
  CONFIRMED
  /// The vendor refused, or retries were exhausted. Terminal and
  /// operator-visible; the lead survives for human follow-up.
  FAILED
}

model FdBookingAttempt {
  id                    String          @id @default(cuid())
  tenantId              String
  tenant                FdTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                String?
  lead                  FdLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// Forwarded to the vendor so a retry cannot create a second reservation.
  idempotencyKey        String          @unique
  status                FdBookingStatus @default(PENDING)
  providerName          String
  /// True when the provider was a mock. Surfaced so a simulated booking can
  /// never be mistaken for a real one.
  simulated             Boolean         @default(false)
  customerName          String
  phone                 String
  email                 String?
  partySize             Int
  /// ISO 8601 with offset, as supplied. No silent UTC coercion (M5).
  requestedAt           DateTime
  notes                 String?
  /// Vendor's confirmation reference. Present if and only if status is
  /// CONFIRMED — that reference IS the confirmation.
  confirmationReference String?
  providerReference     String?
  slotId                String?
  attempts              Int             @default(0)
  maxAttempts           Int             @default(3)
  nextAttemptAt         DateTime?
  lockedAt              DateTime?
  lockedBy              String?
  errorCode             String?
  errorMessage          String?
  lastAttemptAt         DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([tenantId, createdAt])
}

/// M7c — REVIEW REQUEST RECORD (§XIII)
///
/// The auditable trace of who was asked, when, through which channel, and what
/// came back. §XIII requires recording review_request_sent, timestamp, channel
/// and result — this is that record.
///
/// It also makes the compliance property checkable after the fact. Review
/// gating is invisible in code review but obvious in data: if only some
/// customers were ever asked, this table shows it. The eligibility rules take
/// no sentiment input, and these rows are the evidence.
///
/// One row per interaction is enforced by a unique index on
/// (tenantId, conversationId), so a retry or a duplicate webhook cannot ask the
/// same customer twice for the same visit.
enum FdReviewRequestStatus {
  /// Eligible and recorded; nothing sent yet. Sending is not wired up.
  PENDING
  /// Handed to a provider. NOT proof it arrived.
  SENT
  /// Provider confirmed delivery.
  DELIVERED
  /// Provider confirmed it could not deliver, or the attempt was abandoned.
  FAILED
  /// Eligibility was refused. Kept, with the reason, so the refusal is
  /// auditable rather than an absence.
  SUPPRESSED
}

model FdReviewRequest {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           FdTenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     FdConversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status           FdReviewRequestStatus @default(PENDING)
  channel          String                @default("SMS")
  /// Customer destination. Subject to the same retention redaction as leads.
  destination      String?
  reviewLink       String?
  /// Why a request was not sent, when status is SUPPRESSED.
  suppressedReason String?
  /// True when the provider was a mock.
  simulated        Boolean               @default(false)
  requestedAt      DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([tenantId, conversationId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}
