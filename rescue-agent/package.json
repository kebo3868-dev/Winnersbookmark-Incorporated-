{
  "name": "wbi-restaurant-rescue-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Winners Bookmark Restaurant Rescue Agent — restaurant revenue intelligence and AI opportunity detection engine.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "worker:notifications": "node scripts/notification-worker.mjs",
    "smoke:provider": "node --experimental-strip-types scripts/provider-smoke-test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "cheerio": "^1.0.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11",
    "vite": "^7.3.7"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.2",
    "cheerio": {
      "undici": "^7.30.1"
    }
  }
}
