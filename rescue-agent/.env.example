DATABASE_URL="postgresql://user:password@localhost:5432/rescue_agent"

# Optional AI narrative layer. Audit collection, evidence, scoring, and reports
# run deterministically without these. When unset, AI-dependent narrative
# enhancement is marked unavailable — never faked.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
