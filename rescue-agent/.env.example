# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma). Must be a postgres:// URL, not a
# prisma+postgres:// (Accelerate) URL. Runtime resolution order:
# POSTGRES_PRISMA_URL (Neon's pgbouncer-safe pooled URL) → DATABASE_URL →
# POSTGRES_URL → PRISMA_DATABASE_URL. Migrations prefer the unpooled URL
# (DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING). On Vercel the Neon
# integration injects all of these automatically. In docker-compose this is
# derived from POSTGRES_PASSWORD instead.
DATABASE_URL="postgresql://user:password@localhost:5432/rescue_agent"

# ── Required in production ──────────────────────────────────────────────────
# App-wide HTTP Basic Auth. The app serves confidential internal sales
# intelligence: production deployments REFUSE requests (503) until both are
# set. Leave unset for open access in local development only.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Used by docker-compose to provision the bundled PostgreSQL instance.
POSTGRES_PASSWORD=

# ── Optional AI narrative layer ─────────────────────────────────────────────
# Audit collection, evidence, scoring, and reports run deterministically
# without these. When unset, AI-dependent narrative enhancement is marked
# unavailable — never faked.
#
# AI_EXECUTIVE_SUMMARY: feature flag for the AI-written executive summary.
# DEFAULT OFF. Only the exact value `enabled` turns it on; blank, "true", "1"
# and anything else leave it off.
#   Off: new audits store the deterministic summary, and every report (web and
#        PDF) shows the deterministic summary, even for audits whose summary
#        was stored as AI-written earlier. Stored records are not changed.
#   AI_EXECUTIVE_SUMMARY=enabled: new audits request an AI summary only if a
#        provider is also configured (AI_PROVIDER=anthropic and
#        ANTHROPIC_API_KEY); without one they still store the deterministic
#        summary. Summaries stored as AI-written are shown again.
# Scores, evidence, confidence and classification never depend on this flag.
# /api/health (operator credential) reports the resulting state under
# config.executiveSummary.
AI_EXECUTIVE_SUMMARY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── AI Front Desk: messaging ────────────────────────────────────────────────
# Which SMS adapter to use: "mock" (simulated, no network, no cost) or
# "twilio". The mock is REFUSED in production unless
# SMS_ALLOW_MOCK_IN_PRODUCTION=true, because a production deployment that
# silently simulates every alert looks healthy while reaching nobody.
SMS_PROVIDER=mock
SMS_ALLOW_MOCK_IN_PRODUCTION=

# Twilio credentials. Required when SMS_PROVIDER=twilio. Read by name only —
# they are never stored in tenant configuration or the database.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Where Twilio posts delivery receipts. Without it, every alert stops at SENT
# and there is no way to tell "handed to the carrier" from "reached a handset".
# Must exactly match the URL Twilio is configured to call: it is part of the
# signed value, so a mismatch fails verification.
TWILIO_STATUS_CALLBACK_URL=

# Delivery-callback secret for the platform's own HMAC scheme. Required when a
# non-Twilio provider is configured; the Twilio path verifies with the auth
# token instead.
SMS_WEBHOOK_SECRET=

# ── AI Front Desk: dispatch worker ──────────────────────────────────────────
# Shared secret for the scheduled dispatch trigger. Must be at least 16
# characters; shorter values are rejected outright rather than accepted weakly.
CRON_SECRET=

# Your assertion that a scheduler is actually running — either a cron pointed
# at the dispatch endpoint, or `npm run worker:notifications` as a long-lived
# process. The app cannot observe a scheduler from inside a request, and
# without one, alerts are queued and never sent.
FRONTDESK_DISPATCH_SCHEDULED=

# ── AI Front Desk: public endpoint ──────────────────────────────────────────
# Opt-in, defaults to off. Leave unset unless a public unauthenticated message
# endpoint is genuinely intended.
FRONTDESK_PUBLIC_ENDPOINT_ENABLED=

# ── Marketing website: lead ingest ──────────────────────────────────────────
# Shared secret the public marketing website presents when posting an enquiry
# to /api/marketing/leads. Must be at least 24 characters; shorter values (and
# an unset value) make the endpoint refuse every submission rather than accept
# them weakly. Generate with: openssl rand -base64 32
# The SAME value must be set as MARKETING_INGEST_SECRET on the website project.
MARKETING_INGEST_SECRET=

# ── Marketing website: founder notification ─────────────────────────────────
# Where new website enquiries are emailed. Unset means no email is sent — the
# lead is still stored, and the API reports notification as "not_configured"
# rather than pretending it was delivered.
MARKETING_LEAD_NOTIFY_EMAIL=
# The verified sending address the notification comes FROM. Must be on a domain
# verified with the email provider, or every send is rejected.
MARKETING_LEAD_FROM_EMAIL=

# ── Email provider ──────────────────────────────────────────────────────────
# "mock" (simulated; refused in production) or "resend" (real). Unset means no
# email is sent anywhere — staff alerts stay SMS-only, unchanged.
EMAIL_PROVIDER=
EMAIL_ALLOW_MOCK_IN_PRODUCTION=
# Required when EMAIL_PROVIDER=resend. Absent, the provider refuses to
# construct rather than silently falling back to a simulation.
RESEND_API_KEY=
