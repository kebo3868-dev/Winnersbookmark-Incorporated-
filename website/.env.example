# ── Canonical origin ────────────────────────────────────────────────────────
# Set this ONLY once a custom domain is verified and connected in Vercel.
# Until then leave it unset: the site falls back to Vercel's production alias
# (VERCEL_PROJECT_PRODUCTION_URL), which is injected automatically.
#
# When neither resolves, robots.txt disallows indexing — so a local or
# unconfigured build cannot be indexed ahead of the real site.
NEXT_PUBLIC_SITE_URL=

# ── Lead pipeline (required for the contact form to work) ───────────────────
# The Restaurant Rescue Agent's ingest endpoint. The website posts enquiries
# here server-to-server; the browser never sees this URL or the secret.
# Example: https://<rescue-agent-deployment>/api/marketing/leads
LEADS_INGEST_URL=

# Shared secret. Must be BYTE-IDENTICAL to MARKETING_INGEST_SECRET on the
# rescue-agent project, and at least 24 characters.
# Generate with: openssl rand -base64 32
#
# Without both of the above the form does NOT silently discard submissions —
# it shows a visible failure and the direct email address instead.
MARKETING_INGEST_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# A real scheduling URL (Calendly, Cal.com, SavvyCal). Leave unset until one
# exists: every "book a call" affordance falls back to the contact form rather
# than rendering a dead link.
NEXT_PUBLIC_BOOKING_URL=

# Public contact address shown as the fallback when the form cannot submit.
# Defaults to keith@winnersbookmark.com.
NEXT_PUBLIC_CONTACT_EMAIL=
